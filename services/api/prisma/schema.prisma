generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  PARENT
  TEACHER
  MENTOR
  INSTITUTION_ADMIN
  RECRUITER
  PARTNER
  FIELD_AGENT
  SUPPORT
  PLATFORM_ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}


enum ProfileType {
  SCHOOL_STUDENT
  COLLEGE_STUDENT
  COMPETITIVE_EXAM_ASPIRANT
  GOVERNMENT_JOB_ASPIRANT
  JOB_SEEKER
  WORKING_PROFESSIONAL
  SKILL_LEARNER
  SPORTS_PARTICIPANT
  SCHOOL_OWNER
  FOUNDER_TRUSTEE
  PRINCIPAL
  VICE_PRINCIPAL
  SCHOOL_ADMINISTRATOR
  COLLEGE_DIRECTOR
  COLLEGE_ADMINISTRATOR
  COACHING_INSTITUTE_OWNER
  SPORTS_ACADEMY_OWNER
  INSTITUTE_BRANCH_MANAGER
  SCHOOL_TEACHER
  COLLEGE_FACULTY
  TUTOR
  TRAINER
  COURSE_CREATOR
  MENTOR_PROFILE
  CAREER_COUNSELLOR
  PSYCHOMETRIC_ASSESSMENT_SPECIALIST
  CONTENT_CREATOR
  OLYMPIAD_COACH
  EMPLOYER
  RECRUITER_PROFILE
  HR_MANAGER
  HIRING_MANAGER
  INTERNSHIP_PROVIDER
  TRAINING_PARTNER
  MARKETPLACE_SELLER
  EDUCATION_SERVICE_PROVIDER
  ATHLETE
  COACH_PROFILE
  SPORTS_ACADEMY_MANAGER
  REFEREE_JUDGE
  TOURNAMENT_ORGANIZER
  OLYMPIAD_ORGANIZER
  EVENT_SPONSOR
  SPORTS_TALENT_SCOUT
  STATE_PARTNER
  DISTRICT_PARTNER
  REFERRAL_PARTNER
  FRANCHISE_CAMPUS_PARTNER
  FIELD_SALES_EXECUTIVE
  TEAM_LEADER
  ASM
  STATE_SALES_HEAD
  ZONE_HEAD
  SALES_HEAD
  CUSTOMER_SUPPORT
  VERIFICATION_OFFICER
  ASSESSMENT_PROCTOR
  CONTENT_MODERATOR
  FINANCE_EXECUTIVE
  HR_EXECUTIVE
  OPERATIONS_MANAGER
  TECHNICAL_SUPPORT
  PLATFORM_ADMIN_PROFILE
  SUPER_ADMIN_PROFILE
  PARENT_GUARDIAN
  ALUMNI
  COMMUNITY_MODERATOR
  GOVERNMENT_INSTITUTIONAL_LIAISON
  SCHOLARSHIP_PROVIDER
  RESEARCHER_ASSESSMENT_ANALYST
}

enum AccessScope {
  SELF
  ORGANIZATION
  BRANCH
  TERRITORY
  PLATFORM
}

enum TerritoryLevel {
  COUNTRY
  ZONE
  STATE
  DISTRICT
  SUBDISTRICT
}

enum GuardianLinkStatus {
  PENDING
  APPROVED
  REVOKED
}


enum AcademicClassStatus {
  ACTIVE
  ARCHIVED
}

enum StudentEnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonContentType {
  TEXT
  VIDEO
  PDF
  LINK
  LIVE
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  phone        String?       @unique
  passwordHash String
  fullName     String
  role         UserRole      @default(STUDENT)
  status       AccountStatus @default(PENDING)
  emailVerifiedAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  memberships  OrganizationMember[]
  profileRoles RoleAssignment[] @relation("AssignedProfiles")
  grantedProfileRoles RoleAssignment[] @relation("ProfileGrantor")
  guardianLinks GuardianStudentLink[] @relation("GuardianLinks")
  studentLinks GuardianStudentLink[] @relation("StudentLinks")
  createdTerritories Territory[] @relation("TerritoryCreator")
  createdClasses AcademicClass[] @relation("ClassCreator")
  studentEnrollments StudentEnrollment[] @relation("EnrolledStudent")
  createdEnrollments StudentEnrollment[] @relation("EnrollmentCreator")
  teachingAssignments TeacherClassAssignment[] @relation("AssignedTeacher")
  assignedClassTeachers TeacherClassAssignment[] @relation("TeacherAssignmentCreator")
  createdCourses Course[] @relation("CourseCreator")
  attendanceMarked AttendanceRecord[] @relation("AttendanceMarker")
  createdLessons CourseLesson[] @relation("LessonCreator")
  auditEvents  AuditEvent[]  @relation("AuditActor")

  @@index([role, status])
  @@index([createdAt])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  avatarUrl   String?
  bio         String?
  locale      String   @default("en-IN")
  timezone    String   @default("Asia/Kolkata")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  type      String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   OrganizationMember[]
  branches OrganizationBranch[]
  profileRoles RoleAssignment[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}


enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  SPAM
}

model Lead {
  id        String     @id @default(cuid())
  fullName  String
  email     String
  role      String
  message   String     @default("")
  status    LeadStatus @default(NEW)
  source    String     @default("website")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
}


model OrganizationBranch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  slug           String
  address        String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profileRoles   RoleAssignment[]

  @@unique([organizationId, code])
  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model Territory {
  id          String         @id @default(cuid())
  name        String
  code        String         @unique
  level       TerritoryLevel
  parentId    String?
  status      String         @default("ACTIVE")
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  parent      Territory?     @relation("TerritoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Territory[]    @relation("TerritoryTree")
  createdBy   User?          @relation("TerritoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  profileRoles RoleAssignment[]

  @@index([parentId, level])
  @@index([level, status])
}

model RoleAssignment {
  id             String      @id @default(cuid())
  userId         String
  profileType    ProfileType
  accessRole     UserRole
  scopeType      AccessScope @default(SELF)
  organizationId String?
  branchId       String?
  territoryId    String?
  grantedById    String?
  isDefault      Boolean     @default(false)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation("AssignedProfiles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy      User?       @relation("ProfileGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         OrganizationBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  territory      Territory? @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  @@unique([userId, profileType, organizationId, branchId, territoryId])
  @@index([userId, active])
  @@index([profileType, scopeType, active])
  @@index([organizationId, branchId])
  @@index([territoryId, active])
}

model GuardianStudentLink {
  id         String             @id @default(cuid())
  guardianId String
  studentId  String
  status     GuardianLinkStatus @default(PENDING)
  consentAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  guardian   User               @relation("GuardianLinks", fields: [guardianId], references: [id], onDelete: Cascade)
  student    User               @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([guardianId, status])
  @@index([studentId, status])
}


model AcademicClass {
  id             String              @id @default(cuid())
  organizationId String
  branchId       String?
  name           String
  code           String
  gradeLevel     String?
  section        String?
  academicYear   String
  status         AcademicClassStatus @default(ACTIVE)
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         OrganizationBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy      User                @relation("ClassCreator", fields: [createdById], references: [id], onDelete: Restrict)
  enrollments    StudentEnrollment[]
  teachers       TeacherClassAssignment[]
  courses        Course[]
  attendance     AttendanceRecord[]

  @@unique([organizationId, code, academicYear])
  @@index([organizationId, branchId, status])
  @@index([organizationId, academicYear, gradeLevel, section])
}

model StudentEnrollment {
  id          String                   @id @default(cuid())
  classId     String
  studentId   String
  status      StudentEnrollmentStatus  @default(ACTIVE)
  enrolledAt  DateTime                 @default(now())
  withdrawnAt DateTime?
  createdById String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  academicClass AcademicClass           @relation(fields: [classId], references: [id], onDelete: Cascade)
  student     User                     @relation("EnrolledStudent", fields: [studentId], references: [id], onDelete: Cascade)
  createdBy   User                     @relation("EnrollmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([classId, studentId])
  @@index([studentId, status])
  @@index([classId, status])
}

model TeacherClassAssignment {
  id          String        @id @default(cuid())
  classId     String
  teacherId   String
  assignedById String
  createdAt   DateTime      @default(now())
  academicClass AcademicClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher     User          @relation("AssignedTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  assignedBy  User          @relation("TeacherAssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([classId, teacherId])
  @@index([teacherId, classId])
}

model Course {
  id             String       @id @default(cuid())
  organizationId String
  branchId       String?
  classId        String?
  title          String
  description    String       @default("")
  status         CourseStatus @default(DRAFT)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         OrganizationBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  academicClass AcademicClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  createdBy      User         @relation("CourseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lessons        CourseLesson[]

  @@index([organizationId, branchId, status])
  @@index([classId, status])
  @@index([createdById, status])
}

model CourseLesson {
  id          String            @id @default(cuid())
  courseId    String
  title       String
  description String            @default("")
  contentType LessonContentType @default(TEXT)
  contentText String            @default("")
  contentUrl  String?
  sortOrder   Int               @default(0)
  published   Boolean           @default(false)
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("LessonCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([courseId, published, sortOrder])
}

model AttendanceRecord {
  id          String           @id @default(cuid())
  classId     String
  studentId   String
  date        DateTime         @db.Date
  status      AttendanceStatus
  note        String           @default("")
  markedById  String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  academicClass AcademicClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy    User             @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([classId, studentId, date])
  @@index([classId, date])
  @@index([studentId, date])
}
